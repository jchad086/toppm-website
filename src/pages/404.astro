---
import Base from '../layouts/Base.astro';
import { nav } from '../data/site';
---
<Base title="Page Not Found | TOP Property Management" description="The page you were looking for doesn’t exist. Find property management services, rentals and contact details for TOP Property Management in Cornwall, Ontario." noindex>
  <section class="section">
    <div class="container--narrow center">
      <p class="eyebrow">404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lead">It may have moved when we redesigned the site. Try one of these instead.</p>
      <ul class="links">
        <li><a href="/">Home</a></li>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
<style>
  .links { list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .links a { display: inline-block; padding: 0.6rem 1.1rem; background: #fff; border: 1px solid var(--border); border-radius: 999px; text-decoration: none; color: var(--navy); font-family: var(--font-heading); font-weight: 500; }
  .links a:hover { border-color: var(--green); color: var(--green); }
</style>
