---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactForm from '../../components/ContactForm.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import { faqSchema } from '../../components/schema/localBusiness';

const title = 'Contact Us | TOP Property Management | Cornwall, Ontario';
const description = 'Contact TOP Property Management for residential rental property services in Cornwall, Ontario and SD&G. Call (613) 416-3263 or send a message and we’ll reply within one business day.';
const breadcrumbs = [{ name: 'Home', href: '/' }, { name: 'Contact Us', href: '/contact-us/cornwall-property-management' }];
const faqs = [
  { q: 'What happens after I send a message?', a: 'We reply within one business day, usually sooner. For owners, we’ll ask a few questions about the property and suggest a time to talk or visit. For renters, we’ll let you know what’s available and how to apply.' },
  { q: 'I’m a current renter with an emergency. What do I do?', a: `Call ${site.phone.display} any time. Our emergency line is staffed 24/7 for urgent issues such as no heat, flooding, or a lockout at a property we manage.` },
  { q: 'Do you have an office I can visit?', a: 'We are based in Cornwall and meet owners at their property or a convenient location. Contact us to arrange a time.' },
  { q: 'Which areas do you serve?', a: 'Cornwall and the surrounding Stormont, Dundas and Glengarry counties, including Long Sault, Ingleside, Alexandria, Morrisburg, Lancaster and South Glengarry.' },
];
---
<Base {title} {description} {breadcrumbs} jsonLd={[faqSchema(faqs)]}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow">Cornwall property management</p>
      <h1>Contact Us</h1>
      <p class="lead">Let’s handle your rental property needs. Call, email, or send a message and a real person from our Cornwall team will get back to you.</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>Get in touch with TOP Property Management</h2>
        <ul class="contact-cards">
          <li class="card">
            <div class="icon-badge"><Icon name="phone" /></div>
            <h3>Call us</h3>
            <p><a href={site.phone.href}>{site.phone.display}</a></p>
            <p class="small muted">24/7 emergency line for renters in properties we manage.</p>
          </li>
          <li class="card">
            <div class="icon-badge"><Icon name="mail" /></div>
            <h3>Email us</h3>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
            <p class="small muted">We reply within one business day.</p>
          </li>
          <li class="card">
            <div class="icon-badge"><Icon name="pin" /></div>
            <h3>Where we work</h3>
            <p>Cornwall, Ontario and the SD&amp;G counties</p>
            <p class="small muted"><a href="/about-us/cornwall-property-management">See all service areas</a></p>
          </li>
        </ul>
        <div class="social-row">
          <a href={site.social.facebook} rel="noopener" target="_blank"><Icon name="facebook" size={18} /> Facebook</a>
          <a href={site.social.google} rel="noopener" target="_blank"><Icon name="google" size={18} /> Google listing</a>
        </div>
      </div>
      <ContactForm heading="Send us a message" subject="Contact page enquiry — toppm.ca" id="contact-form" />
    </div>
  </section>

  <section class="section section--mint-50">
    <div class="container--narrow">
      <Faq heading="Common questions" items={faqs} />
    </div>
  </section>
</Base>

<style>
  .contact-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 960px) { .contact-grid { grid-template-columns: 1fr 1.1fr; align-items: start; } }
  .contact-info h2 { font-size: var(--step-3); }
  .contact-cards { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1rem; }
  .contact-cards .card { padding: 1.25rem 1.5rem; display: grid; grid-template-columns: auto 1fr; gap: 0 1rem; align-items: start; }
  .contact-cards .icon-badge { grid-row: span 3; margin: 0; }
  .contact-cards h3 { margin: 0 0 0.2rem; }
  .contact-cards p { margin: 0; }
  .contact-cards p a { font-weight: 600; font-size: 1.1rem; }
  .social-row { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .social-row a { display: inline-flex; gap: 0.4rem; align-items: center; text-decoration: none; font-weight: 600; }
</style>
