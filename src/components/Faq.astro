---
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading } = Astro.props;
---
<div class="faq">
  {heading && <h2>{heading}</h2>}
  {items.map((f) => (
    <details class="faq__item">
      <summary><span>{f.q}</span></summary>
      <div class="faq__body"><p>{f.a}</p></div>
    </details>
  ))}
</div>
<style>
  .faq__item { border: 1px solid var(--border); border-radius: var(--radius-sm); background: #fff; margin-bottom: 0.75rem; }
  .faq__item[open] { border-color: var(--green-100); box-shadow: var(--shadow-sm); }
  summary {
    cursor: pointer; list-style: none; padding: 1rem 3rem 1rem 1.25rem; position: relative;
    font-family: var(--font-heading); font-weight: 600; color: var(--navy); font-size: 1.05rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; position: absolute; right: 1.1rem; top: 50%; transform: translateY(-50%);
    width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--mint); color: var(--green);
    display: grid; place-items: center; font-weight: 600;
  }
  .faq__item[open] summary::after { content: '–'; }
  .faq__body { padding: 0 1.25rem 1.25rem; color: var(--text-muted); }
</style>
