---
import { pricing } from '../data/site';
---
<div class="pricing">
  <div class="pricing__main card">
    <p class="eyebrow">Full-service management</p>
    <p class="price"><span class="price__amount">${pricing.monthlyFee}</span><span class="price__unit">per unit / month</span></p>
    <p class="muted">Flat, transparent pricing. No percentage of rent, no hidden markups.</p>
    <ul class="check-list">
      <li>Tenant screening, leasing and move-in inspections</li>
      <li>Rent collection with direct deposit by the {pricing.directDepositDay}</li>
      <li>Monthly statements and year-end summaries (PDF or Excel)</li>
      <li>Maintenance coordination and 24/7 emergency line</li>
      <li>Invoice payment and renter communication</li>
    </ul>
    <a href="/contact-us/cornwall-property-management" class="btn btn--primary">Get started</a>
  </div>
  <div class="pricing__side">
    <div class="card card--mint">
      <h3>Other fees</h3>
      <dl class="fee-list">
        <div><dt>Lease renewal</dt><dd>${pricing.leaseRenewalFee}</dd></div>
        <div><dt>Leasing services</dt><dd>On request</dd></div>
        <div><dt>In-house maintenance</dt><dd>No trip charge, no minimum</dd></div>
        <div><dt>External vendors</dt><dd>{pricing.vendorFeePercent}% project management fee</dd></div>
      </dl>
    </div>
    <div class="card card--mint">
      <h3>Volume discounts</h3>
      <dl class="fee-list">
        {pricing.volumeDiscounts.map((d) => <div><dt>{d.units}</dt><dd>{d.discount} off</dd></div>)}
      </dl>
    </div>
  </div>
</div>
<style>
  .pricing { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .pricing { grid-template-columns: 1.3fr 1fr; align-items: start; } }
  .pricing__main { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; border-color: var(--green-100); }
  .pricing__side { display: grid; gap: 1.5rem; }
  .price { display: flex; align-items: baseline; gap: 0.6rem; margin: 0; }
  .price__amount { font-family: var(--font-heading); font-size: var(--step-5); font-weight: 700; color: var(--navy); line-height: 1; }
  .price__unit { color: var(--text-muted); font-weight: 500; }
  .fee-list { margin: 0; display: grid; gap: 0.6rem; }
  .fee-list div { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px dashed var(--green-100); padding-bottom: 0.5rem; }
  .fee-list div:last-child { border: 0; padding-bottom: 0; }
  .fee-list dt { color: var(--text-muted); }
  .fee-list dd { margin: 0; font-weight: 600; color: var(--navy); text-align: right; }
</style>
