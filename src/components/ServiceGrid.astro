---
import { services } from '../data/site';
import Icon from './Icon.astro';
interface Props { detailed?: boolean; limit?: number }
const { detailed = false, limit } = Astro.props;
const list = limit ? services.slice(0, limit) : services;
---
<div class="grid grid--3">
  {list.map((s) => (
    <article class="card" id={s.id}>
      <div class="icon-badge"><Icon name={s.icon} /></div>
      <h3>{s.title}</h3>
      <p>{s.short}</p>
      {detailed && <p>{s.detail}</p>}
    </article>
  ))}
</div>
