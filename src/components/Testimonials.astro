---
import { testimonials } from '../data/site';
import Icon from './Icon.astro';
interface Props { heading?: string }
const { heading = 'What our clients say about us' } = Astro.props;
---
<section class="section section--mint-50">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">Testimonials</p>
      <h2>{heading}</h2>
    </div>
    <div class="grid grid--3">
      {testimonials.map((t) => (
        <figure class="card testimonial">
          <div class="stars" aria-label="5 out of 5 stars">
            {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={18} />)}
          </div>
          <blockquote><p>“{t.quote}”</p></blockquote>
          <figcaption><strong>{t.name}</strong> <span class="muted">· {t.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .testimonial { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .stars { display: flex; gap: 2px; color: #e2a62a; }
  .stars :global(svg) { fill: currentColor; }
  blockquote { margin: 0; flex: 1; }
  blockquote p { color: var(--text); font-size: 1rem; }
  figcaption { font-size: 0.95rem; }
</style>
